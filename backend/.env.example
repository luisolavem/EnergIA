# Variables de entorno del backend. El archivo .env real no se publica.

# InfluxDB
INFLUX_URL=http://localhost:8086
INFLUX_TOKEN=
INFLUX_ORG=EnergIA
INFLUX_BUCKET=datos_consumo_energetico

# Broker MQTT
MQTT_HOST=localhost
MQTT_PORT=1883

# Autenticacion del dashboard
JWT_SECRETO=
AUTH_OBLIGATORIA=1

# Base de datos de usuarios (por defecto, energia.db junto a main.py)
# RUTA_BD=
